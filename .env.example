# ---- Frontend (copy to frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend (export before starting uvicorn; all optional) ----
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Annual risk-free rate used in Sharpe/Sortino (SORA proxy)
STATARB_RISK_FREE=0.03
# 1 = never call yfinance (guaranteed-offline classroom demo)
STATARB_OFFLINE=0
# Override where market_data.db and csv/ live
# STATARB_DATA_DIR=backend/data
